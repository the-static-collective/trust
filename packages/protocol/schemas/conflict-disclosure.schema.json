{
  "$id": "https://trust.static/schemas/conflict-disclosure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["disclosure_id", "trust_id", "related_party_refs", "action_ref", "disclosure_carrier_refs", "recusal_state", "approval_refs", "consent_refs", "court_order_refs", "recorded_at"],
  "properties": {
    "disclosure_id": {"type": "string", "minLength": 1},
    "trust_id": {"type": "string", "minLength": 1},
    "related_party_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "action_ref": {"type": "string", "minLength": 1},
    "disclosure_carrier_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recusal_state": {"enum": ["recused", "not_recused", "not_applicable", "unknown"]},
    "approval_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "consent_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "court_order_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/extensions"}
  }
}
