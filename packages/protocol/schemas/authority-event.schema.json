{
  "$id": "https://trust.static/schemas/authority-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "actor_refs", "action_type", "authority_basis_refs", "approval_refs", "recorded_at", "status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "actor_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "action_type": {"type": "string", "minLength": 1},
    "authority_basis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approval_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "effective_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["proposed", "approved", "executed", "reversed", "disputed", "unknown"]},
    "extensions": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/extensions"}
  }
}
