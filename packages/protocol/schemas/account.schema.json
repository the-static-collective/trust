{
  "$id": "https://trust.static/schemas/account.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id", "author_ref", "account_kind", "recorded_at", "text", "source_refs", "audiences", "adult_conflict", "memory_eligible"],
  "properties": {
    "account_id": {"type": "string", "minLength": 1},
    "author_ref": {"type": "string", "minLength": 1},
    "account_kind": {"enum": ["observation", "recollection", "interpretation", "allegation", "administrative_record"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "text": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "audiences": {"type": "array", "minItems": 1, "items": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/audience"}, "uniqueItems": true},
    "adult_conflict": {"type": "boolean"},
    "memory_eligible": {"type": "boolean"},
    "assertions": {"type": "array", "items": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/assertion"}},
    "extensions": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/extensions"}
  }
}
