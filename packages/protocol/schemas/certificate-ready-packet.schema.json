{
  "$id": "https://trust.static/schemas/certificate-ready-packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "trust_id", "trust_name", "instrument_date", "trustees", "trustees_required_to_act", "termination_revocation_state", "authority_boundary", "prepared_at"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "trust_id": {"type": "string", "minLength": 1},
    "trust_name": {"type": "string", "minLength": 1},
    "instrument_date": {"type": "string", "format": "date"},
    "trustees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trustee_ref", "powers", "limitations"],
        "properties": {
          "trustee_ref": {"type": "string", "minLength": 1},
          "address": {"type": "string"},
          "powers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "trustees_required_to_act": {"type": "integer", "minimum": 1},
    "termination_revocation_state": {"enum": ["active", "terminated", "revoked", "unknown"]},
    "authority_boundary": {"const": "draft_data_only"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "execution_carrier_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "extensions": {"$ref": "https://trust.static/schemas/common.schema.json#/$defs/extensions"}
  }
}
